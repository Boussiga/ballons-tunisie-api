# Ballons Tunisie - API (Express + Prisma + MySQL)
# Copy this file to ".env" and fill the values. NEVER commit ".env".

# Server
PORT=3000
# Set to "production" on a real server (enforces a strong JWT_SECRET)
NODE_ENV=development
# Set to 1 when the API runs behind nginx / a reverse proxy / Docker (correct client IP for rate limiting)
# TRUST_PROXY=1

# Database (MySQL)
# mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME
# With docker compose this is set for you (host "db").
DATABASE_URL="mysql://root:password@localhost:3306/foot"

# Security
# Long random string, 32+ characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# CORS: who may call this API from a browser
# Comma-separated list of the exact origins (scheme + host + port, no trailing slash)
# of the back office AND the front office.
# Dev:  back office = 5173, store = 5174     Docker: store = 8080
# Prod: https://admin.example.com,https://www.example.com
FRONTEND_URL="http://localhost:5173,http://localhost:5174,http://localhost:8080"

# Cloudinary (product images)
# Cloudinary console -> Settings -> API Keys. The API secret is private: it only lives here.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Optional: folder where images are stored
# CLOUDINARY_FOLDER="ballons-tunisie/produits"

# First admin account (used by "npm run db:seed")
# If SEED_ADMIN_PASSWORD is empty a random one is generated and printed once.
SEED_ADMIN_EMAIL="admin@ballons-tunisie.tn"
SEED_ADMIN_PASSWORD=""
