# Production values for docker-compose.yml.
# Copy this file to ".env.production" on the server and fill in every value.
# NEVER commit ".env.production".
# Then: docker compose --env-file .env.production up -d --build

# Database (MySQL)
# Use letters and digits only in the passwords: they are placed in a connection URL.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MYSQL_DATABASE=ballons
MYSQL_USER=ballons
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Security
# Long random string, 32+ characters (the API refuses to start otherwise). Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Public HTTPS addresses of the store and of the back office, comma-separated, no trailing slash
# Example: https://www.ballonstunisie.tn,https://admin.ballonstunisie.tn
FRONTEND_URL=

# Number of proxies in front of the API: 1 if the store/back-office nginx receive the
# visitors directly, 2 if an HTTPS reverse proxy or load balancer sits in front of them.
# A wrong value makes every visitor share the same rate limit.
TRUST_PROXY=1

# Cloudinary (product images): Cloudinary console -> Settings -> API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Separate folder from the demo / development images
CLOUDINARY_FOLDER=ballons-tunisie/production

# First admin account, created by:
#   docker compose --env-file .env.production exec api npm run admin:create
# Password: 12+ characters with uppercase, lowercase and a digit.
# Remove SEED_ADMIN_PASSWORD from this file once the account is created.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
